rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'tumbuyona25@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'tumbuyona25+admin@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- User Profile Rules ---
    match /users/{userId} {
      // Allow anybody to check if a referral code exists (used during registration)
      allow list: if isAdmin() || request.query.limit == 1;
      
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // --- Profit Entry Rules ---
    match /profits/{profitId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // --- Commissions Rules ---
    match /commissions/{commId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // --- Withdrawals Rules ---
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isAdmin();
    }

    // --- News Rules ---
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Settings Rules ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Admins Rules ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
    }
  }
}
