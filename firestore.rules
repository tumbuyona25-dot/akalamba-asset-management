rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    // Super Admin logic
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'tumbuyona25@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'tumbuyona25+admin@gmail.com') ||
        request.auth.uid == 'njO30nloO9c4Qq9fZRTfodj2afE3' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- User Profile Rules ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 1);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // --- Profit Entry Rules ---
    match /profits/{profitId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // --- Commissions Rules ---
    match /commissions/{commId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // --- Withdrawal Rules ---
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- News Rules ---
    match /news/{newsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Support Messages Rules ---
    match /support_messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- Settings Rules ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Admins Rules ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Catch-all bypass for admin for other potential collections
    match /{allDocs=**} {
      allow read, write: if isAdmin();
    }
  }
}
